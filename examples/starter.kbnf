# K'UHUL syntax contract (EBNF)
program         ::= statement*
statement       ::= declaration | instruction | phase-block | lane-block | binding
                 | xpath-expression-statement | host-phase-block | phase-expression
                 | micronaut-block | aiml-block | srai-binding | eliza-block
                 | xcfe-block
declaration     ::= "glyph" identifier "=" string
instruction     ::= opcode "(" argument-list? ")"
opcode          ::= "map" | "filter" | "fold" | "reduce" | "sync" | "emit" | "verify" | "dispatch"
phase-block     ::= phase "{" statement* "}"
phase           ::= "Pop" | "Wo" | "Yax" | "Sek" | "Ch'en" | "Xul" | legacy-phase-alias
legacy-phase-alias ::= "Chen" (* canonicalized to "Ch'en"; not a seventh phase *)
lane-block      ::= "lane" identifier ":" type "{" statement* "}"
binding         ::= "bind" identifier "->" identifier | micronaut "->" target binding-options?
micronaut       ::= "µ" hex-digit+
target          ::= micronaut | glyph-reference | lane-ref | field-ref | vector-ref
lane-ref        ::= "lane:" identifier
field-ref       ::= "field:" identifier
vector-ref      ::= "vector:" identifier
binding-options ::= "[" binding-property ("," binding-property)* "]"
binding-property ::= "type=" binding-type | "mode=" binding-mode | "weight=" number
binding-type    ::= "semantic" | "vector" | "field" | "program" | "state"
binding-mode    ::= "read" | "sync" | "invoke" | "fold"
hex-digit       ::= digit | "A".."F" | "a".."f"
type            ::= "Glyph" | "Vector" | "Field" | "Tensor" | "Graph" | "Scalar" | "Memory" | "Program"
argument-list   ::= value ("," value)*
value           ::= identifier | number | string | glyph-reference
glyph-reference ::= "⟁" identifier
identifier      ::= letter (letter | digit | "_")*
number          ::= digit+
string          ::= "\"" character* "\""
letter          ::= "A".."Z" | "a".."z"
digit           ::= "0".."9"
character       ::= ? printable except quote ?

(* XPath 3.1 host grammar extension.
   XPath31Expr and EQName are external references to the normative XPath 3.1
   Appendix A productions "Expr" and "EQName". Their internal precedence,
   namespaces, predicates, functions, sequences, maps, and arrays are unchanged.
   K'UHUL extensions are separate typed host statements around those expressions. *)
XPath31Expr     ::= ? external production "Expr" from W3C XPath 3.1 Appendix A ?
EQName          ::= ? external production "EQName" from W3C XPath 3.1 Appendix A ?
xpath-expression-statement ::= XPath31Expr ";"

host-phase-block ::= "[Pop" identifier "]" host-statement* "[Xul" identifier "]"
host-statement   ::= phase-expression | micronaut-block | aiml-block | srai-binding
                   | eliza-block | xcfe-block | pattern-binding | xpath-expression-statement
phase-expression ::= "[" expression-phase XPath31Expr "]"
expression-phase ::= "Wo" | "Yax" | "Sek" | "Ch'en" | "Xul"

micronaut-block  ::= "[Micronaut" EQName "]" host-statement* "[Xul Micronaut]"
aiml-block       ::= "[AIML" EQName "]" pattern-binding* "[Xul AIML]"
srai-binding     ::= "[SRAI" EQName "->" EQName "]"
eliza-block      ::= "[ELIZA" EQName "]" host-statement* "[Xul ELIZA]"
xcfe-block       ::= "[XCFE" EQName "]" host-statement* "[Xul XCFE]"
pattern-binding  ::= "[Pattern" string "->" EQName "]"

(* xgc: A host closing marker is recognized only at XPath bracket depth zero,
   outside XPath strings, comments, and enclosed constructors. Predicate
   brackets inside XPath31Expr remain XPath syntax. The active host block type
   and name must match the closing marker. *)
