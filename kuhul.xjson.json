{
  "@meta": {
    "@id": "kuhul-xsl-semantic-bindings",
    "@name": "K'UHUL XSL Semantic Bindings",
    "@format": "kuhul.xsl.semantic-bindings/1",
    "@version": "1.0.0",
    "@status": "declarative_projection",
    "@domain": "kuhul.dev"
  },
  "@runtime": {
    "@engine": "XSL",
    "@dataModel": "XML-style nodes and XPath 3.1 values",
    "@backend": "K'UHUL phase runtime",
    "@sourceOfMicronautBindings": "vendor/key-grammar-kit/data/micronauts/kuhul-micronaut-registry.json",
    "@resourceSurface": [
      "program",
      "micronaut",
      "widget",
      "topology",
      "intent_graph",
      "vector",
      "image",
      "video",
      "database_table",
      "mml_field",
      "gml_field",
      "mml_graph",
      "gml_graph"
    ]
  },
  "@phases": {
    "Pop": {
      "@code": "000",
      "@role": "ingress",
      "@operators": [
        "MAP"
      ]
    },
    "Wo": {
      "@code": "001",
      "@role": "assignment",
      "@operators": [
        "FILTER",
        "FOLD"
      ]
    },
    "Yax": {
      "@code": "010",
      "@role": "expansion",
      "@operators": [
        "MAP",
        "FILTER"
      ]
    },
    "Sek": {
      "@code": "011",
      "@role": "selection",
      "@operators": [
        "MAP",
        "FILTER",
        "FOLD",
        "REDUCE"
      ]
    },
    "Ch'en": {
      "@code": "100",
      "@role": "verification",
      "@operators": [
        "FILTER",
        "REDUCE"
      ]
    },
    "Xul": {
      "@code": "101",
      "@role": "closure",
      "@operators": [
        "FOLD"
      ]
    }
  },
  "@micronauts": {
    "micronaut:ELIZA": {
      "@descriptorStatus": "declarative_proposal",
      "@identity": {
        "id": "micronaut:ELIZA",
        "name": "ELIZA-µ",
        "class": "conversational",
        "version": "1.0",
        "authority_claim": "proposal_only",
        "evidence_refs": [
          "data/manifest/eliza.manifest.json",
          "data/manifest/aiml.manifest.json"
        ]
      },
      "@phaseBindings": {
        "Pop": {
          "role": "conversation_ingress",
          "descriptor_ref": "phase:Pop"
        },
        "Wo": {
          "role": "intent_binding",
          "descriptor_ref": "phase:Wo"
        },
        "Yax": {
          "role": "question_generation",
          "descriptor_ref": "phase:Yax"
        },
        "Sek": {
          "role": "candidate_selection",
          "descriptor_ref": "phase:Sek"
        },
        "Ch'en": {
          "role": "proposal_verification",
          "descriptor_ref": "phase:Ch'en"
        },
        "Xul": {
          "role": "fold_closure",
          "descriptor_ref": "phase:Xul"
        }
      },
      "@capabilities": {
        "declared": [
          "question_proposal",
          "pattern_matching",
          "wildcard_capture",
          "intent_reflection",
          "gap_detection",
          "semantic_routing",
          "candidate_ranking"
        ],
        "registered": [],
        "registered_status": "not_verified_in_this_declarative_document",
        "registration_source": "active runtime registry"
      },
      "@lanes": {
        "input": "lane:CONVERSATION",
        "pattern": "lane:WILDCARD",
        "intent": "lane:INTENT",
        "question": "lane:QUESTION",
        "output": "lane:PROPOSAL"
      },
      "@xcfe": {
        "admission_requirement": "required_before_execution",
        "execution_claim": "not_implicitly_authorized",
        "proposal_authority_claim": "proposal_only",
        "lane_authorization_requirement": "required",
        "phase_authorization_requirement": "required",
        "verification_phase_ref": "phase:Ch'en",
        "closure_phase_ref": "phase:Xul"
      },
      "@output": {
        "type": "QuestionProposal",
        "format": "semantic_map",
        "persistence_claim": false,
        "dispatch_claim": false
      },
      "@aiml": {
        "grammar": "aiml.runtime/5",
        "pattern_ref": "aiml:FORGETTING_PATTERN",
        "pattern": "MY MODEL KEEPS FORGETTING *",
        "capture_count": 1,
        "capture_lane": "lane:WILDCARD",
        "template_ref": "template:MEMORY_REFLECTION",
        "status": "proposed_reference_unverified"
      },
      "@srai": {
        "redirect": "srai:DIAGNOSE_MEMORY",
        "canonical_intent": "intent:MEMORY_DIAGNOSIS",
        "max_redirects": 8,
        "cycle_detection": true,
        "status": "proposed_reference_unverified"
      },
      "@cfpc": {
        "intent": "cfpc:MEMORY_FAILURE",
        "gap": "cfpc:MEMORY_FAILURE_MECHANISM",
        "gap_family": "KNOWLEDGE_GAP_NO_VALUES",
        "route": "micronaut:QUESTION_ENGINE",
        "classification": "candidate"
      },
      "@learning": {
        "enabled_claim": true,
        "mode_claim": "proposal_only",
        "gradient_lane_ref": "lane:GRADIENT",
        "feedback_lane_ref": "lane:FEEDBACK",
        "target_ref": "gramstore:W_learned",
        "commit_requirement": "authorized_xul_only",
        "corpus_weights_claim": "immutable"
      },
      "@questions": [
        {
          "key": "question:STORAGE_OR_RETRIEVAL",
          "text": "Is information lost from storage, or is retrieval failing?",
          "default_weight": 0.9,
          "source": "seed"
        },
        {
          "key": "question:WHICH_SESSION",
          "text": "Does the failure happen across sessions?",
          "default_weight": 0.82,
          "source": "seed"
        },
        {
          "key": "question:MEMORY_SCOPE",
          "text": "What information should the system remember?",
          "default_weight": 0.76,
          "source": "seed"
        }
      ],
      "@wcr": {
        "weight_ref": "gramstore:W",
        "confidence_ref": "evidence:C",
        "relativity_ref": "context:R",
        "score_formula_ref": "formula:WCR",
        "gate_ref": "xcfe:ADMISSION"
      }
    },
