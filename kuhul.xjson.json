    "micronaut:XJSON_PROCESSOR": {
      "@descriptorStatus": "contract_declared_registration_unverified",
      "@identity": {
        "id": "micronaut:XJSON_PROCESSOR",
        "name": "Micronaut XJSON Processor",
        "class": "semantic_document_projection",
        "authority_claim": "data_projection_only",
        "binary_ref": "micronaut/micronaut-coder/micronaut_xjson.exe",
        "source_runtime_ref": "micronaut/xjson.py"
      },
      "@phaseBindings": {
        "Wo": { "role": "bind_document_and_contract", "descriptor_ref": "phase:Wo" },
        "Yax": { "role": "project_xjson_nodes_and_route_metadata", "descriptor_ref": "phase:Yax" },
        "Sek": { "role": "host_route_request_only", "descriptor_ref": "phase:Sek" },
        "Ch'en": { "role": "validate_projection_and_contract", "descriptor_ref": "phase:Ch'en" },
        "Xul": { "role": "return_verified_projection", "descriptor_ref": "phase:Xul" }
      },
      "@capabilities": {
        "declared": ["xjson_project", "xjson_static_route_describe", "phase_contract_validate"],
        "registered": [],
        "registered_status": "not_verified_in_this_declarative_document",
        "registration_source": "host RPC registry"
      },
      "@lanes": {
        "input": "lane:XJSON_DOCUMENT",
        "projection": "lane:XML_NODE_PROJECTION",
        "routes": "lane:STATIC_API_DECLARATIONS",
        "output": "lane:XJSON_PROPOSAL"
      },
      "@contract": {
        "source_ref": "micronaut/micronaut-coder/micronaut_xjson.contract.kl",
        "validation_rpc": "code-micronaut-worker.validate-contract",
        "validation_status": "must_be_checked_by_host"
      },
      "@xcfe": {
        "admission_requirement": "required_before_native_invocation",
        "dispatch_claim": "host_controlled",
        "projection_authority_claim": "data_only",
        "static_api_execution_claim": false,
        "phase_authorization_requirement": "required",
        "verification_phase_ref": "phase:Ch'en",
        "closure_phase_ref": "phase:Xul"
      },
      "@output": {
        "type": "XJSONProjectionProposal",
        "xml_node_projection": true,
        "declared_routes_are_data": true,
        "persistence_claim": false,
        "dispatch_claim": false
      }
    }
  },
  "@xsl": {
    "@matchingModel": "XSL template patterns select source nodes; templates transform or route selected nodes",
    "@nodeRules": [
      {
        "@id": "bind-phase-descriptors",
        "@match": "xj:entry[@key='@phases']",
        "@phaseRef": "phase:Wo",
        "@operation": "resolve_data_binding",
        "@effect": "none"
      },
      {
        "@id": "bind-micronaut-descriptors",
        "@match": "xj:entry[@key='@micronauts']",
        "@phaseRef": "phase:Wo",
        "@operation": "resolve_data_binding",
        "@effect": "none"
      },
      {
        "@id": "route-aiml-patterns",
        "@match": "xj:entry[@key='@aiml']",
        "@phaseRef": "phase:Yax",
        "@operation": "pattern_route_candidate",
        "@effect": "proposal_only"
      },
      {
        "@id": "route-srai-intents",
        "@match": "xj:entry[@key='@srai']",
        "@phaseRef": "phase:Yax",
        "@operation": "canonical_intent_candidate",
        "@effect": "proposal_only"
      },
      {
        "@id": "classify-cfpc-gaps",
        "@match": "xj:entry[@key='@cfpc']",
        "@phaseRef": "phase:Wo",
        "@operation": "gap_binding_candidate",
        "@effect": "classification_only"
      },
      {
        "@id": "verify-proposal-nodes",
        "@match": "xj:entry[@key='@xcfe']",
        "@phaseRef": "phase:Ch'en",
        "@operation": "verification_reference",
        "@effect": "no_admission"
      },
      {
        "@operation": "program_reference_candidate",
        "@phaseRef": "phase:Sek",
        "@id": "route-program-reference",
        "@effect": "xcfe_admission_required",
        "@match": "xj:entry[@key='@program']"
      },
      {
        "@operation": "widget_reference_candidate",
        "@phaseRef": "phase:Sek",
        "@id": "route-widget-reference",
        "@effect": "host_controlled",
        "@match": "xj:entry[@key='@widget']"
      },
      {
        "@operation": "topology_binding",
        "@phaseRef": "phase:Wo",
        "@id": "route-topology-reference",
        "@effect": "none",
        "@match": "xj:entry[@key='@topology']"
      },
      {
        "@id": "propose-intent-graph-questions",
        "@phaseRef": "phase:Yax",
        "@operation": "field_bigram_question_candidates",
        "@effect": "proposal_only",
        "@match": "xj:entry[@key='@topology']/xj:entry[@key='@intentGraph']"
      },
      {
        "@operation": "typed_resource_binding",
        "@phaseRef": "phase:Wo",
        "@id": "route-data-resource",
        "@effect": "none",
        "@match": "xj:entry[@key=('vector','image','video','database_table','mml_field','gml_field','mml_graph','gml_graph')]"
      },
      {
        "@effect": "xcfe_admission_required",
        "@match": "xj:entry[@key='@program']",
        "@operation": "program_reference_candidate",
        "@phaseRef": "phase:Sek",
        "@id": "route-program-reference"
      },
      {
        "@effect": "host_controlled",
        "@match": "xj:entry[@key='@widget']",
        "@operation": "widget_reference_candidate",
        "@phaseRef": "phase:Sek",
        "@id": "route-widget-reference"
      },
      {
        "@effect": "none",
        "@match": "xj:entry[@key='@topology']",
        "@operation": "topology_binding",
        "@phaseRef": "phase:Wo",
        "@id": "route-topology-reference"
      },
      {
        "@effect": "none",
        "@match": "xj:entry[@key=('vector','image','video','database_table','mml_field','gml_field','mml_graph','gml_graph')]",
        "@operation": "typed_resource_binding",
        "@phaseRef": "phase:Wo",
        "@id": "route-data-resource"
      },
      {
        "@id": "prompt-to-field-candidate",
        "@phaseRef": "phase:Yax",
        "@effect": "proposal_only",
        "@operation": "semantic_field_candidate_generation",
        "@match": "xj:entry[@key='@context']"
      },
      {
        "@operation": "micronaut_call_proposal",
        "@effect": "xcfe_admission_required",
        "@phaseRef": "phase:Sek",
        "@match": "xj:entry[@key='@micronaut']",
        "@id": "route-micronaut-reference"
      }
    ],
    "@effectfulDispatch": "must delegate to runtime after XCFE admission",
    "@stylesheetRef": "micronaut/xjson-bindings.xsl",
    "@resourceKinds": [
      "program",
      "micronaut",
      "widget",
      "topology",
      "vector",
      "image",
      "video",
      "database_table",
      "mml_field",
      "gml_field",
      "mml_graph",
      "gml_graph"
    ]
  },
  "@topology": {
    "@intentGraph": {
      "@schema": "kgf.intent-graph/1",
      "@source": "vendor/key-grammar-kit/data/intent-graph.gml",
      "@reader": "micronaut/intent_graph.py",
      "@daemonPath": "micronaut/daemon_eliza.py:run_pipeline",
      "@phase": "Yax",
      "@output": "QuestionCandidate",
      "@effect": "proposal_only",
      "@admission": "separate_xcfe_gate",
      "@cyclePolicy": "active_path_detection",
      "@maxDepth": 4
    }
  },
  "@xcfe": {
    "@control": "separate_runtime_gate",
    "@admission": "external_per_invocation",
    "@nodeMatching": "selecting a node is not admission",
    "@dispatch": "host_controlled",
    "@learningCommit": "authorized_xul_only",
    "@authorityClaim": false
  },
  "@contributors": {
    "@embeddings": ".micronaut/checkpoints/neighborhood-attention.safetensors",
    "@embeddingIndex": ".micronaut/checkpoints/neighborhood-attention.safetensors.index.json",
    "@embeddingModel": "embeddinggemma:latest",
    "@foldGeometry": ".micronaut/checkpoints/neighborhood-attention.bones.safetensors",
    "@foldGeometryMetadata": ".micronaut/checkpoints/neighborhood-attention.bones.json",
    "@classificationTrace": ".micronaut/checkpoints/neighborhood-attention.cfpc.jsonl",
    "@proposalTrace": ".micronaut/checkpoints/neighborhood-attention.pi-trace.jsonl",
    "@role": "semantic_geometry_and_bias_contributors",
    "@authority": false
  },
  "@questionGeneration": {
